FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN groupadd --gid 10001 internet-hands \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin internet-hands

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir '.[fleet]'

RUN mkdir -p /app/.internet-hands \
    && chown -R internet-hands:internet-hands /app

USER internet-hands

CMD ["ih-worker", "--batch-size", "16", "--idle-seconds", "5"]
