INTERNET_HANDS_API_KEY=change-me
INTERNET_HANDS_DB=.internet-hands/internet-hands.db
INTERNET_HANDS_OBJECTS=.internet-hands/objects
INTERNET_HANDS_TELEMETRY_DB=.internet-hands/telemetry.db
# Set to 1 only for trusted local development when you intentionally want no API key.
INTERNET_HANDS_ALLOW_UNAUTHENTICATED=0

# Distributed fleet coordination. Leave unset to use local SQLite frontier mode.
INTERNET_HANDS_POSTGRES_DSN=

# Shared distributed capture/document metadata.
INTERNET_HANDS_CONTENT_POSTGRES_DSN=

# Shared worker event stream. Usually points at the same Postgres cluster/database.
INTERNET_HANDS_TELEMETRY_POSTGRES_DSN=

# S3-compatible raw object storage. Required with distributed capture storage.
INTERNET_HANDS_S3_BUCKET=
INTERNET_HANDS_S3_PREFIX=internet-hands/objects
INTERNET_HANDS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Distributed fleet API binding.
INTERNET_HANDS_FLEET_API_HOST=0.0.0.0
INTERNET_HANDS_FLEET_API_PORT=8788

# External tool mesh. Apify Store search works without a token; running Actors requires one.
APIFY_TOKEN=
COMPOSIO_API_KEY=
# Optional comma-separated fnmatch patterns such as "apify:*" or "composio:GITHUB_*".
# If ALLOW is non-empty, only matching refs are visible/executable. DENY always wins.
INTERNET_HANDS_TOOL_ALLOW=
INTERNET_HANDS_TOOL_DENY=
INTERNET_HANDS_TOOL_MAX_BATCH=20
INTERNET_HANDS_TOOL_MAX_RESPONSE_BYTES=1000000

# Provider credentials. Leave unset for providers that do not need them.
YOUTUBE_API_KEY=
YOUTUBE_ANALYTICS_ACCESS_TOKEN=
GITHUB_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
REDDIT_ACCESS_TOKEN=
BRAVE_SEARCH_API_KEY=
