INTERNET_HANDS_API_KEY=change-me
INTERNET_HANDS_DB=.internet-hands/internet-hands.db
INTERNET_HANDS_OBJECTS=.internet-hands/objects
INTERNET_HANDS_TELEMETRY_DB=.internet-hands/telemetry.db
# Set to 1 only for trusted local development when you intentionally want no API key.
INTERNET_HANDS_ALLOW_UNAUTHENTICATED=0

# v0.7 SaaS/control plane. The control DB may use the same Postgres DSN as the fleet.
INTERNET_HANDS_CONTROL_POSTGRES_DSN=
INTERNET_HANDS_PUBLIC_URL=https://web-scrapping-cli.vercel.app
# Dedicated signing/encryption secrets should be long random values in production.
INTERNET_HANDS_OAUTH_SIGNING_SECRET=
INTERNET_HANDS_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email. Resend is preferred when both providers are configured;
# set MAIL_PROVIDER=smtp to override. The other configured provider is fallback.
MAIL_PROVIDER=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Internet Hands
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
# Optional fallback provider if SMTP is not configured.
RESEND_API_KEY=
INTERNET_HANDS_FROM_EMAIL=
RESEND_FROM_EMAIL=

# Phone ownership verification and non-identifying telecom risk intelligence.
# Providers are tried only at preflight; once an OTP send starts Internet Hands will
# not automatically retry another provider, preventing duplicate verification messages.
PHONE_VERIFY_PROVIDERS=twilio,vonage,msg91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=
# Optional Twilio Lookup SIM-swap signal. Requires account/carrier approval and has
# limited country/carrier coverage. Line-type lookup can work without this flag.
TWILIO_LOOKUP_SIM_SWAP=0
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_VERIFY_BRAND=Internet Hands
VONAGE_VERIFY_VOICE_FALLBACK=1
# Optional Vonage fraud assessment; enable only when the account supports it.
VONAGE_VERIFY_FRAUD_CHECK=0
# MSG91 SendOTP v5 (good regional option; delivery itself is usage-priced).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MINUTES=10

# Phone intelligence runs local/free first, then configured enrichers, then Twilio.
PHONE_INTEL_PROVIDERS=local,veriphone,abstract,numverify,twilio
VERIPHONE_API_KEY=
VERIPHONE_MODE=static
ABSTRACT_PHONE_API_KEY=
NUMVERIFY_API_KEY=
# APILAYER_API_KEY is accepted as an alias for Numverify.
APILAYER_API_KEY=

# Distributed fleet coordination. Leave unset to use local SQLite frontier mode.
INTERNET_HANDS_POSTGRES_DSN=

# Shared distributed capture/document metadata.
INTERNET_HANDS_CONTENT_POSTGRES_DSN=

# Shared worker event stream. Usually points at the same Postgres cluster/database.
INTERNET_HANDS_TELEMETRY_POSTGRES_DSN=

# S3-compatible raw object storage. Required with distributed capture storage.
INTERNET_HANDS_S3_BUCKET=
INTERNET_HANDS_S3_PREFIX=internet-hands/objects
INTERNET_HANDS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Distributed fleet API binding.
INTERNET_HANDS_FLEET_API_HOST=0.0.0.0
INTERNET_HANDS_FLEET_API_PORT=8788

# External Tool Mesh.
# Apify Store discovery works without a token; Actor execution requires one.
APIFY_TOKEN=
# Composio catalog/execution requires an API key and uses connected accounts server-side.
COMPOSIO_API_KEY=

# Connected-account-aware Composio bridge. Discovery defaults to ACTIVE connected
# toolkits only; execution remains locked until an account is explicitly allowlisted.
INTERNET_HANDS_COMPOSIO_CONNECTED_ONLY=true
INTERNET_HANDS_COMPOSIO_CONNECTION_TTL=60
INTERNET_HANDS_COMPOSIO_TOOLKITS=
INTERNET_HANDS_COMPOSIO_ACCOUNT_ALLOW=
INTERNET_HANDS_COMPOSIO_ALLOW_PROJECT_ACCOUNTS=false
INTERNET_HANDS_COMPOSIO_EXPOSE_ACCOUNT_ALIASES=false
# Firecrawl v2 web-context provider. Search/scrape/map/crawl/agent execution requires a key.
FIRECRAWL_API_KEY=
# Optional operator-controlled Firecrawl/self-hosted base URL. Defaults to https://api.firecrawl.dev.
FIRECRAWL_API_URL=
# RapidAPI credentials stay server-side and are injected only into configured manifests.
RAPIDAPI_KEY=

# Gaming Intelligence provider credentials.
# Riot Games developer API key; injected only as X-Riot-Token by the server.
RIOT_API_KEY=
# Steam Web API key; injected only as the provider query key by the server.
STEAM_WEB_API_KEY=
# HenrikDev VALORANT community API key. Never expose it to the calling agent.
HENRIKDEV_API_KEY=
# Hypixel Public API key. Sent in the API-Key header server-side.
HYPIXEL_API_KEY=
# osu! v2 public OAuth access header. Include the Bearer prefix, e.g. "Bearer <token>".
OSU_AUTHORIZATION=
# Supercell developer API Authorization headers. Include the Bearer prefix.
BRAWL_STARS_AUTHORIZATION=
CLASH_OF_CLANS_AUTHORIZATION=
CLASH_ROYALE_AUTHORIZATION=

# Add read-only RapidAPI/public HTTP tools without changing Python code.
# Both values are JSON arrays of manifest objects documented in docs/TOOL_MESH.md.
INTERNET_HANDS_RAPIDAPI_TOOLS=
INTERNET_HANDS_PUBLIC_API_TOOLS=

# Add public OpenAPI catalogs. Example:
# [{"name":"example","url":"https://api.example.com/openapi.json"}]
INTERNET_HANDS_OPENAPI_SOURCES=

# Add public Streamable-HTTP MCP endpoints. Example:
# [{"name":"example","url":"https://mcp.example.com/mcp"}]
# v0.5 remote MCP ingestion intentionally supports public endpoints only; authenticated
# connected-app workflows should use the Composio provider.
INTERNET_HANDS_REMOTE_MCP_SOURCES=

# Optional comma-separated fnmatch patterns such as "apify:*" or "composio:GITHUB_*".
# If ALLOW is non-empty, only matching refs are visible/executable. DENY always wins.
INTERNET_HANDS_TOOL_ALLOW=
INTERNET_HANDS_TOOL_DENY=
INTERNET_HANDS_TOOL_MAX_BATCH=20
INTERNET_HANDS_TOOL_MAX_RESPONSE_BYTES=1000000

# Provider credentials. Leave unset for providers that do not need them.
YOUTUBE_API_KEY=
YOUTUBE_ANALYTICS_ACCESS_TOKEN=
GITHUB_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
REDDIT_ACCESS_TOKEN=
BRAVE_SEARCH_API_KEY=
